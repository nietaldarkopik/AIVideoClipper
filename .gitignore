# This file only covers things at the repo root and inside tools/.
# backend/ and frontend/ each have their own .gitignore (Laravel, Next.js).

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
.fleet/
.nova/
.zed/

# Env files anywhere in the repo. The last pattern catches what Windows Explorer
# names a duplicate by default (e.g. ".env copy", ".env - Copy (2)") — an actual
# leaked-secrets incident: a stray ".env copy" wasn't covered by ".env.*" (that
# requires a dot, not a space, before the suffix) and got committed with real
# credentials in it.
.env
.env.*
.env*[Cc]opy*
!.env.example

# Logs
*.log

# Python (tools/whisper-engine)
__pycache__/
*.pyc
venv/
.venv/

# Portable redis runtime state (tools/redis) — binaries stay tracked
tools/redis/dump.rdb
tools/redis/*.pid
tools/redis/redis.log

# Dev scratch data (tools/testdata)
tools/testdata/node_modules/
tools/testdata/shots/
tools/testdata/*_check.png
tools/testdata/*_check.jpg

# Instagram automation debug screenshots — can contain a plaintext password
# (see tools/instagram-automation/instagram.js pre-submit-unmasked capture)
tools/instagram-automation/debug-screenshots/

# Persistent per-account browser profiles (cookies, cache) used to make
# Instagram automation logins look like a returning device
tools/instagram-automation/profiles/

node_modules