APP_NAME="AI Video Clipper"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This app is built and run against PostgreSQL.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clipper_tool
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis-backed queues. Two workers must run alongside the app:
#   php artisan queue:work redis --queue=default
#   php artisan queue:work redis --queue=batch-downloads
# Restart both after deploying any change to a Job/Provider class — a running
# worker keeps old bindings until restarted.
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The Next.js frontend's origin — used for CORS/Sanctum and any links this
# app generates. SANCTUM_STATEFUL_DOMAINS should match its host:port.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# -----------------------------------------------------------------------
# AI provider selection — pick which implementation each capability uses.
# Every one defaults to "mock" (zero external calls, zero cost), so the app
# runs end-to-end out of the box; flip individual lines to "openai",
# "nine_router", etc. once real credentials are configured below. These are
# also overridable per-install at runtime from the Admin > Settings page
# (that DB override takes priority over the env value here).
# -----------------------------------------------------------------------
AI_TRANSCRIPTION_PROVIDER=mock
AI_ANALYSIS_PROVIDER=mock
AI_REFRAMING_PROVIDER=mock
AI_SOCIAL_METADATA_PROVIDER=mock
AI_REACTION_SCRIPT_PROVIDER=mock
AI_TTS_PROVIDER=mock
AI_EMBEDDING_PROVIDER=mock
AI_WEB_FETCH_PROVIDER=mock
AI_WEB_SEARCH_PROVIDER=mock
AI_VIDEO_NARRATIVE_PROVIDER=mock
AI_CONTENT_IDEA_PROVIDER=mock
AI_COVER_IMAGE_PROVIDER=mock
MAX_CLIPS_PER_VIDEO=10
DEFAULT_CLIP_DURATION=30

# --- 9Router (https://9router.com) — self-hosted OpenAI-compatible LLM gateway ---
# Only used by whichever AI_*_PROVIDER lines above are set to "nine_router".
# base_url/api_key are shared; each model id is per-capability because a
# single 9Router instance can route each to a different upstream credential.
# Check GET {base_url}/models on your own instance for valid ids — "auto" is
# NOT a real model id and will 404. See NineRouter*Provider classes and
# AIServiceProvider for exactly how each is used.
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=
NINE_ROUTER_TRANSCRIBE_MODEL=
NINE_ROUTER_TTS_MODEL=
NINE_ROUTER_REACTION_SCRIPT_MODEL=
NINE_ROUTER_EMBEDDING_MODEL=
NINE_ROUTER_WEB_FETCH_MODEL=
NINE_ROUTER_WEB_SEARCH_MODEL=
NINE_ROUTER_VIDEO_NARRATIVE_MODEL=
NINE_ROUTER_CONTENT_IDEA_MODEL=
NINE_ROUTER_IMAGE_MODEL=

# --- Other AI providers (only needed if a capability above targets them) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# From Google AI Studio (aistudio.google.com/apikey) — unrelated to the
# Google OAuth client below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Self-hosted — point at wherever Ollama actually runs. No auth of its own,
# so treat this URL as sensitive if reachable from outside a trusted network.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=180

# tools/whisper-engine (self-hosted local transcription) — see its README.
WHISPER_ENGINE_URL=http://127.0.0.1:8100
WHISPER_ENGINE_TIMEOUT=3600
WHISPER_ENGINE_CHUNK_SECONDS=120

# -----------------------------------------------------------------------
# Media pipeline (ffmpeg/ffprobe/yt-dlp) and face tracking
# -----------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp
FFMPEG_PRESET=superfast
# A real .ttf/.otf path — bare font *names* need a working libfontconfig,
# which isn't a safe cross-machine assumption (see config/services.php).
DEFAULT_FONT_FILE=

# yt-dlp client impersonation, tried in order (works around YouTube's
# Proof-of-Origin token requirement — which client(s) still work shifts
# over time as YouTube patches this).
YTDLP_PLAYER_CLIENTS=android,tv,web
# Routes every yt-dlp request through this proxy when a platform blocks this
# server's IP outright, e.g. http://user:pass@host:port or socks5://host:port
YTDLP_PROXY=

# tools/face-tracker (self-hosted Python service) — see its README to run it.
FACE_TRACKER_URL=http://127.0.0.1:8200

# -----------------------------------------------------------------------
# Database/file backup (backup:* / restore:* artisan commands) — for
# migrating this app + its data to another server. See DB_CONNECTION above
# for which client these need to match (pg_dump/psql for pgsql).
# -----------------------------------------------------------------------
PG_DUMP_BIN=pg_dump
PSQL_BIN=psql
TAR_BIN=tar
FACE_TRACKER_TIMEOUT=300

# -----------------------------------------------------------------------
# Social publishing — OAuth apps + automation services
# -----------------------------------------------------------------------
# console.cloud.google.com: enable "YouTube Data API v3" > Credentials >
# create an OAuth client ID (Web application) > register redirect_uri below
# verbatim as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# developers.facebook.com: a Meta app with Facebook Login configured.
# Register redirect_uri below verbatim as a Valid OAuth Redirect URI, and
# this domain as an App Domain in Settings > Basic (Meta rejects bare
# "localhost"/wildcard tricks — use a real reverse-proxied domain).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_REDIRECT_URI=

# tools/instagram-automation (self-hosted Puppeteer service, no official
# API) — InstagramProvider logs in with a stored username/password instead.
IG_AUTOMATION_URL=http://127.0.0.1:8300
IG_AUTOMATION_TIMEOUT=180

# -----------------------------------------------------------------------
# Trending feed
# -----------------------------------------------------------------------
# YouTube defaults to a curated mock list. Set to youtube_api and provide
# YOUTUBE_API_KEY (console.cloud.google.com > "YouTube Data API v3" >
# Credentials > API key — separate from the OAuth client above) for real
# trending data. The other platforms have no official trending API and stay
# mock unless pointed at 9Router web search — see config/services.php.
TRENDING_YOUTUBE_PROVIDER=mock
YOUTUBE_API_KEY=
TRENDING_TIKTOK_PROVIDER=mock
TRENDING_INSTAGRAM_PROVIDER=mock
TRENDING_FACEBOOK_PROVIDER=mock
TRENDING_TWITTER_PROVIDER=mock
TRENDING_CACHE_TTL=900
TRENDING_REGION_CODE=US

# -----------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------
# Minutes a ProcessingJob can sit at status=running with no progress update
# before it's assumed dead (crashed worker/PC restart) and marked failed.
PROCESSING_JOB_STALL_MINUTES=20
# Pause between the batch autobot's sequential downloads.
BATCH_DOWNLOAD_DELAY_SECONDS=10

POSTMARK_API_KEY=
RESEND_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------
# Content Research Engine
# -----------------------------------------------------------------------
# Multi-source research -> daily content ideas, per content channel.
# See config/research.php, App\Services\Research\*, and `php artisan research:daily`.
#
# Most research providers need NO credentials and work out of the box:
#   Google Trends, Google News, Reddit, RSS, Hacker News, GitHub, Dev.to,
#   Stack Overflow, Product Hunt, Steam.
# The three below are optional — a provider without its credentials is SKIPPED
# with a visible reason, never counted as a failure, and never blocks a run.

# YOUTUBE_API_KEY above is reused by the YouTube research provider (no second key).
# TMDB (themoviedb.org > Settings > API) — powers the movie/TV research source.
# IMDb has no public API, so IMDb links are resolved through TMDB instead.
TMDB_API_KEY=
# Twitch (dev.twitch.tv/console/apps) — "which games are being watched right now".
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: raises GitHub's public search limit from 10 to 30 req/min.
GITHUB_TOKEN=

# Priority score weights. Do not have to sum to 1 — TopicScorer normalizes by the
# total, so raising one weight does not silently rescale every score. Each channel
# can override these from the UI.
RESEARCH_WEIGHT_TREND=0.30
RESEARCH_WEIGHT_RELEVANCE=0.30
RESEARCH_WEIGHT_ORIGINALITY=0.15
RESEARCH_WEIGHT_FRESHNESS=0.10
RESEARCH_WEIGHT_ENGAGEMENT=0.10
RESEARCH_WEIGHT_CROSS_SOURCE=0.05

# Topic clustering / duplicate detection thresholds (0-1 Jaccard similarity).
RESEARCH_CLUSTER_THRESHOLD=0.34
RESEARCH_DUPLICATE_THRESHOLD=0.62
RESEARCH_DUPLICATE_LOOKBACK_DAYS=90

RESEARCH_HTTP_TIMEOUT=20
RESEARCH_HTTP_RETRIES=2
RESEARCH_CACHE_TTL=900
RESEARCH_USER_AGENT="ClipperToolResearchBot/1.0"
