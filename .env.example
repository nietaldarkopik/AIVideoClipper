# Compose-level settings + everything the Laravel containers read.
# For the full list of provider/OAuth keys, copy the ones you need from
# backend/.env.example into this file (they are passed to every backend container).

# Required. Generate with:
#   docker compose run --rm --no-deps -e APP_KEY=x api php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Required. Use a strong value; Postgres is not published to the host.
DB_PASSWORD=
DB_DATABASE=clipper_tool
DB_USERNAME=clipper

# Host ports / browser-facing API URL (rebuild the frontend after changing the latter).
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Providers default to mock; switch per capability once keys are set.
AI_TRANSCRIPTION_PROVIDER=mock
AI_REFRAMING_PROVIDER=mock
